{
  "name": "field-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "build:static": "astro build",
    "dev:activity": "wrangler dev --config dist/server/wrangler.json --port 4321 --persist-to .wrangler/state",
    "db:generate": "drizzle-kit generate",
    "test:activity": "node --test tests/activity.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@lucide/astro": "^1.59.0",
    "astro": "latest",
    "katex": "latest",
    "rehype-katex": "latest",
    "remark-math": "latest",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "latest",
    "@cloudflare/vite-plugin": "latest",
    "vite": "latest",
    "wrangler": "latest",
    "drizzle-kit": "latest",
    "drizzle-orm": "latest",
    "@types/three": "^0.186.0"
  }
}
