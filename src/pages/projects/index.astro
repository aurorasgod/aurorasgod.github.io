---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProjectSketch from '../../components/ProjectSketch.astro';
import { url } from '../../site';
const projects=(await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
const labels={ongoing:'持续整理',planned:'计划中',complete:'已完成'};
---
<Base title="项目" active="projects"><div class="page-container projects-page"><div class="page-heading"><div><span class="eyebrow">PROJECTS & PRACTICE</span><h1>项目<span class="title-dot">.</span></h1><p>阅读之外，记录具体的实现和实践。</p></div></div>
  <div class="project-list">{projects.map((project,i)=><article class="project-row"><div class="project-visual" data-project-kind={i % 3} aria-hidden="true"><ProjectSketch id={project.id}/></div><div class="project-copy"><div class="project-topline"><span class="eyebrow">{project.data.category}</span><span class="project-status"><span></span>{labels[project.data.status]}</span></div><h2><a href={url(`projects/${project.id}/`)}>{project.data.title}</a></h2><p>{project.data.description}</p><div class="project-bottom"><div class="tags">{project.data.tags.map(t=><span>{t}</span>)}</div><a class="text-link" href={url(`projects/${project.id}/`)}>项目介绍 <Icon name="arrow" size={16}/></a></div></div></article>)}</div>
</div></Base>
