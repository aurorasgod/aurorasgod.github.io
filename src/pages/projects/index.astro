---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../site';
const projects=(await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
const labels={ongoing:'持续整理',planned:'计划中',complete:'已完成'};
---
<Base title="项目" active="projects"><div class="page-container projects-page"><div class="page-heading"><div><span class="eyebrow">PROJECTS & PRACTICE</span><h1>项目<span class="title-dot">.</span></h1><p>阅读之外，记录具体的实现和实践。</p></div></div>
  <div class="project-list">{projects.map((project,i)=><article class="project-row"><div class="project-visual" data-project-kind={i} aria-hidden="true">{i===0?<svg viewBox="0 0 280 220" fill="none"><rect x="35" y="35" width="210" height="150" rx="8"/><path d="M35 60h210M96 60v125M115 87h112M115 106h78M115 145h43M177 145h50M51 86h28M51 105h28M51 124h18"/><circle cx="49" cy="48" r="2"/><circle cx="59" cy="48" r="2"/></svg>:i===1?<svg viewBox="0 0 280 220" fill="none"><circle cx="70" cy="110" r="22"/><circle cx="140" cy="65" r="22"/><circle cx="140" cy="155" r="22"/><circle cx="210" cy="110" r="22"/><path d="m88 96 34-21m-34 49 34 21m36-70 34 21m-34 49 34-21M140 87v46"/></svg>:<svg viewBox="0 0 280 220" fill="none"><path d="M40 110h40l8-16 12 32 12-32 12 32 8-16h32m0-25v50m12-50v50m0-25h50v-45H40v90h186v-45"/><circle cx="226" cy="110" r="3"/><path d="M62 55v20M52 65h20M63 140v12"/></svg>}</div><div class="project-copy"><div class="project-topline"><span class="eyebrow">{project.data.category}</span><span class="project-status"><span></span>{labels[project.data.status]}</span></div><h2><a href={url(`projects/${project.id}/`)}>{project.data.title}</a></h2><p>{project.data.description}</p><div class="project-bottom"><div class="tags">{project.data.tags.map(t=><span>{t}</span>)}</div><a class="text-link" href={url(`projects/${project.id}/`)}>项目介绍 <Icon name="arrow" size={16}/></a></div></div></article>)}</div>
</div></Base>
