---
import Base from '../../layouts/Base.astro';
import { site, categories, url } from '../../site';
import Icon from '../../components/Icon.astro';
---
<Base title="关于" active="about"><div class="page-container about-page"><div class="about-heading"><span class="eyebrow">ABOUT</span><h1>关于<span class="title-dot">.</span></h1><p class="about-lead">我是 Laplace，Qimai Yan。<br/><em>「人生海海，山山而川」。</em></p></div><div class="about-layout"><div class="prose"><h2>这里记录什么</h2><p>ZJU电力电子硕士在读。一个电力电子人却有颗探索世界的心</p><h2>写作与整理</h2><p>日常使用 Obsidian 中自己开发的工作台阅读和整理笔记，另有插件将md文件编辑成独立文章。每篇文章可以从分类、标签和站内搜索找到。</p><h2>阅读说明</h2><p>文章修订时会注明更新时间。</p>{(site.github||site.email)&&<><h2>联系</h2>{site.github&&<p><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></p>}{site.email&&<p><a href={`mailto:${site.email}`}>{site.email}</a></p>}</>}</div><aside class="about-directions"><span class="eyebrow">文章主题</span>{categories.slice(0,3).map((c,i)=><a href={url(`articles/?category=${c.id}`)}><span class="about-index">0{i+1}</span><h3>{c.name}</h3><p>{c.description}</p><Icon name="arrow" size={18}/></a>)}</aside></div></div></Base>
