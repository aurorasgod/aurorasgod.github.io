---
import Base from '../../layouts/Base.astro';
import { site, categories, url } from '../../site';
import Icon from '../../components/Icon.astro';
---
<Base title="关于" active="about"><div class="page-container about-page"><div class="about-heading"><span class="eyebrow">ABOUT THIS NOTEBOOK</span><h1>关于<span class="title-dot">.</span></h1><p class="about-lead">我是 Laplace，Qimai Yan。<br/><em>这里是我的研究笔记。</em></p></div><div class="about-layout"><div class="prose"><h2>这里记录什么</h2><p>这个网站围绕具身智能、VLA、世界模型和电力电子，整理论文阅读笔记、代码复现过程，以及学习中产生的问题。</p><p>文章尽量保留推理过程：问题从哪里来，方法解决了什么，实验如何验证，以及哪些地方还没有想清楚。</p><h2>写作与整理</h2><p>日常使用 Obsidian 阅读和整理笔记，再把适合分享的内容编辑成独立文章。每篇文章可以从分类、标签和站内搜索找到。</p><h2>阅读说明</h2><p>研究笔记会随着理解加深继续修订；有修改时，会在文章中注明更新时间。页面中的示例文章用于展示阅读排版，均带有“示例文章”标记。</p>{(site.github||site.email)&&<><h2>联系</h2>{site.github&&<p><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></p>}{site.email&&<p><a href={`mailto:${site.email}`}>{site.email}</a></p>}</>}</div><aside class="about-directions"><span class="eyebrow">主要方向</span>{categories.slice(0,3).map((c,i)=><a href={url(`articles/?category=${c.id}`)}><span class="about-index">0{i+1}</span><h3>{c.name}</h3><p>{c.description}</p><Icon name="arrow" size={18}/></a>)}</aside></div></div></Base>
