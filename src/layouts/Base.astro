---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site, url } from '../site';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteRuntime from '../components/SiteRuntime.astro';
import { fade } from 'astro:transitions';
interface Props { title?: string; description?: string; active?: string; article?: boolean; noindex?: boolean; }
const { title, description = site.description, active = 'home', article = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} · ${site.chineseTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN" transition:animate={fade({ duration: '200ms' })}>
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  {noindex && <meta name="robots" content="noindex,follow" />}
  <meta name="description" content={description}/>
  <SiteRuntime />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/>
  <link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" title={site.title} href={url('rss.xml')}/>
  {article && <meta name="giscus:backlink" content={canonical.href}/>}
  <meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(url('social.svg'),Astro.site)}/>
  <title>{pageTitle}</title>
</head>
<body data-base={import.meta.env.BASE_URL} data-section={active}>
  <a class="skip-link" href="#main">跳到正文</a>
  <SiteHeader active={active} />
  <main id="main"><slot/></main>
  <footer class="site-footer"><div><span class="footer-brand">Laplace<span>·</span></span><span class="footer-caption">© {new Date().getFullYear()} {site.fullName}</span></div><div class="footer-links"><a href={url('rss.xml')}>RSS <Icon name="rss" size={14}/></a><a href={url('about/')}>关于</a></div></footer>
  <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
    <div class="search-dialog-top"><h2 id="search-title">搜索笔记</h2><button class="icon-button" data-close-search aria-label="关闭搜索"><Icon name="close"/></button></div>
    <label class="dialog-search-input"><Icon name="search"/><span class="sr-only">关键词</span><input id="global-search" type="search" placeholder="搜索文章，或输入 #标签…" autocomplete="off"/></label>
    <div class="search-status" aria-live="polite">输入关键词搜索</div><ul id="search-results" class="search-results"></ul>
    <div class="search-help"><span>支持关键词与 #标签，可组合搜索</span><kbd>ESC 关闭</kbd></div>
  </dialog>
  <button class="back-to-top icon-button" data-back-top aria-label="回到顶部" hidden><Icon name="back"/></button>
  <script>import '../scripts/ui.ts'; import '../scripts/activity.ts';</script>
</body>
</html>
<style is:global>
  .site-header { position: sticky; top: 0; z-index: 40; background: var(--bg); }
  @media(max-width:700px) { .site-header .brand-sub, .site-header .tool-separator { display: none; } }
</style>
