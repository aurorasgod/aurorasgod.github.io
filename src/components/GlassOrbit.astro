---
import '../styles/glass-orbit.css';
interface Props { background: string; }
const { background } = Astro.props;
---
<div class="glass-orbit" data-glass-orbit data-background={background} aria-hidden="true">
  <div class="glass-orbit-fallback"><span></span><span></span></div>
  <canvas class="glass-orbit-canvas"></canvas>
</div>
<script>
  import { onPageLoad } from '../scripts/page-lifecycle';
  onPageLoad(({ signal }) => {
  const host = document.querySelector<HTMLElement>('[data-glass-orbit]');
  if (host) {
    import('../scripts/glass-orbit').then(({ createGlassOrbit }) => { if (!signal.aborted) return createGlassOrbit(host, signal); }).catch(() => {
      host.dataset.glassState = 'fallback';
    });
  }
  });
</script>
