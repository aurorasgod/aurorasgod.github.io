---
import { Play, Pause, Volume2, VolumeX, Repeat2, EighthNotes, X } from '@lucide/astro';
import { soundtrack } from '../data/home';
import { url } from '../site';
import '../styles/music.css';
---
<div class="music-widget" data-music-player data-audio-src={soundtrack.src ? url(soundtrack.src) : ''}>
  <button class="music-trigger" type="button" popovertarget="music-popover" aria-label="音乐台" aria-controls="music-popover" aria-expanded="false" title="音乐台" data-music-trigger><EighthNotes size={18} /><span class="music-indicator" aria-hidden="true"></span></button>
  <div id="music-popover" class="music-popover" popover="auto" role="dialog" aria-labelledby="music-heading">
    <div class="music-heading"><h2 id="music-heading">音乐台</h2><span class="music-status" role="status" data-music-status>{soundtrack.src ? '已暂停' : '等待音频'}</span><button class="music-icon" type="button" popovertarget="music-popover" popovertargetaction="hide" aria-label="关闭音乐台" title="关闭音乐台"><X size={16} /></button></div>
    <div class="track-row"><div class="record-art" aria-hidden="true"><div class="record-grooves"><span>L.</span></div></div><div class="track-copy"><h3>{soundtrack.title}</h3><p>{soundtrack.version}</p></div></div>
    <div class="track-timeline"><input class="track-progress" type="range" min="0" max="100" step="0.1" value="0" disabled data-music-seek aria-label="播放进度" /><div class="track-time"><time data-music-current>0:00</time><time data-music-duration>--:--</time></div></div>
    <div class="transport"><button class="music-play" data-music-play disabled aria-label="播放" title="播放"><Play size={19} class="play-symbol" /><Pause size={19} class="pause-symbol" /></button><button class="music-icon" data-music-repeat aria-pressed="true" title="单曲循环" aria-label="单曲循环"><Repeat2 size={17} /></button><div class="volume-control"><button class="music-icon" data-music-mute aria-pressed="false" aria-label="静音" title="静音"><Volume2 size={18} class="volume-symbol" /><VolumeX size={18} class="mute-symbol" /></button><input type="range" min="0" max="1" step="0.01" value="0.5" data-music-volume aria-label="音量" /></div></div>
    <audio preload="none" loop data-music-audio></audio>
  </div>
</div>
<script>import '../scripts/music';</script>
