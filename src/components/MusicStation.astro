---
import { Play, Pause, Volume2, VolumeX, Repeat2, Repeat1, SkipBack, SkipForward, ListMusic, EighthNotes, X } from '@lucide/astro';
import { soundtracks } from '../data/home';
import { url } from '../site';
import '../styles/music.css';
const tracks = soundtracks.map(track => ({ ...track, src: url(track.src) }));
const first = tracks[0];
---
<div class="music-widget" data-music-player data-playlist={JSON.stringify(tracks)}>
  <button class="music-trigger" type="button" popovertarget="music-popover" aria-label="音乐台" aria-controls="music-popover" aria-expanded="false" title="音乐台" data-music-trigger><EighthNotes size={18} /><span class="music-indicator" aria-hidden="true"></span></button>
  <div id="music-popover" class="music-popover" popover="auto" role="dialog" aria-labelledby="music-heading">
    <div class="music-heading"><h2 id="music-heading">音乐台</h2><span class="music-status" role="status" data-music-status>{first ? '已暂停' : '暂无曲目'}</span><button class="music-icon" type="button" popovertarget="music-popover" popovertargetaction="hide" aria-label="关闭音乐台" title="关闭音乐台" data-music-close><X size={16} /></button></div>
    <div class="track-row"><div class="record-art" aria-hidden="true"><div class="record-grooves"><span>L.</span></div></div><div class="track-copy" aria-live="polite" aria-atomic="true"><h3 data-music-title>{first?.title || '暂无曲目'}</h3><p data-music-version>{first?.version || ''}</p></div></div>
    <div class="track-timeline"><input class="track-progress" type="range" min="0" max="100" step="0.1" value="0" disabled data-music-seek aria-label="播放进度" /><div class="track-time"><time data-music-current>0:00</time><time data-music-duration>--:--</time></div></div>
    <div class="transport">
      <button class="music-icon" type="button" data-music-previous disabled={tracks.length < 2} aria-label="上一曲" title="上一曲"><SkipBack size={19}/></button>
      <button class="music-play" type="button" data-music-play disabled aria-label="播放" title="播放"><Play size={19} class="play-symbol"/><Pause size={19} class="pause-symbol"/></button>
      <button class="music-icon" type="button" data-music-next disabled={tracks.length < 2} aria-label="下一曲" title="下一曲"><SkipForward size={19}/></button>
      <button class="music-icon" type="button" data-music-repeat aria-pressed="false" title="列表循环" aria-label="单曲循环"><Repeat2 size={17} class="list-repeat-symbol"/><Repeat1 size={17} class="single-repeat-symbol"/></button>
      <button class="music-icon" type="button" data-music-list aria-expanded="false" aria-controls="music-playlist" title="播放列表" aria-label="播放列表"><ListMusic size={18}/></button>
    </div>
    <div class="volume-control"><button class="music-icon" type="button" data-music-mute aria-pressed="false" aria-label="静音" title="静音"><Volume2 size={18} class="volume-symbol"/><VolumeX size={18} class="mute-symbol"/></button><input type="range" min="0" max="1" step="0.01" value="0.5" data-music-volume aria-label="音量"/><span class="track-position" data-music-position>{first ? `1 / ${tracks.length}` : '0 / 0'}</span></div>
    <p class="music-credit" data-music-credit hidden={!first?.credit}><a data-music-author href={first?.credit?.source} target="_blank" rel="noopener noreferrer">{first?.credit?.artist}</a><span> · </span><a data-music-license href={first?.credit?.licenseUrl} target="_blank" rel="noopener noreferrer">{first?.credit?.license}</a></p>
    <ol class="music-playlist" id="music-playlist" aria-label="曲目" hidden>{tracks.map((track, index) => <li><button type="button" data-music-track={track.id} aria-current={index === 0 ? 'true' : undefined}><span class="playlist-number">{String(index + 1).padStart(2, '0')}</span><span><strong>{track.title}</strong><small>{track.version}</small></span></button></li>)}</ol>
    <audio preload="none" data-music-audio></audio>
  </div>
</div>
<script>import '../scripts/music';</script>
