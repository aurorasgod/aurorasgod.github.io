---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { categories, url } from '../site';
interface Props { posts: CollectionEntry<'blog'>[]; projects: CollectionEntry<'projects'>[]; }
const { posts, projects } = Astro.props;
---
<aside class="notebook-rail" aria-label="主题与项目">
  <section class="rail-section"><h2>主题目录<span>Topics</span></h2><nav class="topic-directory" aria-label="文章主题">{categories.map(c=><a href={url(`articles/?category=${c.id}`)}><div class="topic-heading"><strong>{c.name}</strong><span class="topic-count">{posts.filter(p=>p.data.category===c.id).length}<Icon name="right" size={13}/></span></div><p>{c.description}</p></a>)}</nav></section>
  <section class="rail-section rail-projects"><h2>在做的项目<span>Building</span></h2><div>{projects.map(project=><a href={url(`projects/${project.id}/`)}><strong>{project.data.title}<Icon name="arrow" size={15}/></strong><p>{project.data.tags.slice(0,2).join(' / ')}</p></a>)}</div><a class="text-link" href={url('projects/')}>全部项目 <Icon name="arrow" size={14}/></a></section>
</aside>
