---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { categories, url } from '../site';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
---
<aside class="notebook-rail" aria-label="文章主题">
  <section class="rail-section"><h2>主题目录<span>Topics</span></h2><nav class="topic-directory" aria-label="文章主题">{categories.map(c=>{const count=posts.filter(p=>p.data.category===c.id).length;return <a href={url(`articles/?category=${c.id}`)}><div class="topic-heading"><strong>{c.name}</strong><span class="topic-count">{count>0&&count}<Icon name="right" size={13}/></span></div><p>{c.description}</p></a>;})}</nav></section>
</aside>
