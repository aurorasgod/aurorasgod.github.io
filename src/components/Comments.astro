---
import Icon from './Icon.astro';
import { comments, commentTerm } from '../lib/comments';
import { url } from '../site';
import { createHash } from 'node:crypto';
import frameStyles from '../styles/comments-frame.css?raw';
import themeSource from '../pages/comments/[theme].css.ts?raw';
interface Props { slug: string; }
const { slug } = Astro.props;
const themeVersion = createHash('sha256').update(frameStyles).update(themeSource).digest('hex').slice(0, 12);
---
<section id="comments" class="article-comments" aria-labelledby="comments-heading"
  data-comments data-term={commentTerm(slug)} data-theme-base={url('comments/')} data-theme-version={themeVersion} data-state="idle">
  <header class="comments-header">
    <h2 id="comments-heading">评论<span class="section-en">Discussion</span><span class="comments-count" data-comments-count hidden></span></h2>
    <a class="text-link comments-external" href={comments.discussionUrl} target="_blank" rel="noopener noreferrer" data-discussion-link>GitHub 讨论<Icon name="arrow" size={15}/></a>
  </header>
  <p class="comments-description">登录 GitHub 后参与讨论，支持 Markdown。</p>
  <div class="comments-status" data-comments-status role="status" aria-live="polite">
    <span class="comments-loading-dot" aria-hidden="true"></span>
    <span data-comments-status-text>正在加载评论…</span>
    <button class="text-link comments-retry" type="button" data-comments-retry hidden>重新加载</button>
  </div>
  <div class="giscus" aria-label="文章评论" data-comments-mount></div>
  <noscript><p class="comments-no-script">请启用 JavaScript，或<a href={comments.discussionUrl} target="_blank" rel="noopener noreferrer">在 GitHub 中查看讨论</a>。</p></noscript>
</section>
<script>import '../scripts/comments';</script>
<style>
  .article-comments{margin-top:54px;padding-top:29px;border-top:1px solid var(--line);scroll-margin-top:35px;min-width:0}
  .comments-header{display:flex;align-items:baseline;justify-content:space-between;gap:18px}
  .comments-header h2{font:500 19px/1.5 var(--display);display:flex;align-items:baseline;gap:14px}
  .comments-header .section-en{font-size:12px}
  .comments-count{font:11px/1.5 var(--ui);font-variant-numeric:tabular-nums;color:var(--accent)}
  .comments-external{font-size:11px;color:var(--muted);white-space:nowrap}
  .comments-description{font:11px/1.8 var(--ui);color:var(--muted);margin:12px 0 24px}
  .comments-status{display:flex;flex-wrap:wrap;align-items:center;gap:11px;min-height:130px;font:12px/1.8 var(--ui);color:var(--muted)}
  .comments-loading-dot{width:5px;height:5px;border-radius:50%;background:var(--accent)}
  .comments-retry{font-size:12px;color:var(--accent);text-decoration:underline;text-underline-offset:4px}
  .article-comments[data-state=error] .comments-status{min-height:80px;padding:18px 0}
  .comments-no-script{font:12px/1.8 var(--ui);color:var(--muted)}
  .comments-no-script a{color:var(--accent)}
  .article-comments :global(.giscus-frame){display:block;width:100%;border:0;color-scheme:normal}
  @media(max-width:700px){.article-comments{margin-top:42px;padding-top:25px}.comments-header h2{font-size:18px;gap:11px}.comments-header .section-en{font-size:11px}.comments-external{font-size:10px}.comments-description{margin-bottom:21px}}
</style>
